# Copy to .env.local and fill in from your Supabase project's API settings.
# Both values are safe to expose in the browser — data is protected by
# row-level security, not by hiding the key. Without them the app runs in
# local-only mode (no sign-in, data stays on the device).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
